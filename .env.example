# Copy this file to `.env` and fill in real values. Never commit the real `.env` (it already is
# in .gitignore) - this example file only exists so anyone setting the project up (including future you,
# on a new machine or a server) knows exactly which variables are required.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local (XAMPP) example:      mysql://root:@localhost:3306/hittechpro_next
# Namecheap cPanel example:   mysql://cpaneluser_dbuser:dbpassword@localhost:3306/cpaneluser_hittechpro
DATABASE_URL="mysql://root:@localhost:3306/hittechpro_next"

# Signs admin/customer login sessions. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value in production than in local development, and never share it.
JWT_SECRET="change-this-to-a-long-random-string"

# The first admin account. Created by `npm run seed` the first time you set up the database.
# Change the password from Admin -> Settings -> Security right after your first production login.
ADMIN_EMAIL="admin@hittechpro.net"
ADMIN_PASSWORD="Admin@12345"

# Optional - SMTP is now configured from Admin -> Settings -> Email, which takes effect immediately
# with no restart and no file edit. These are only a fallback for values left empty there (or for
# setting up the very first admin account before you can log in to fill in the panel).
# Left empty everywhere, every transactional email (welcome, order confirmation, reset, delivery...) is
# only printed to the server console (fine for local development).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HiT Tech Pro <no-reply@hittechpro.net>"

# Required for the SMM Panel feature. Get your key from my.smmiu.com -> Account. Without it, the SMM
# service sync/order-placement calls fail (the public page and admin panel still load fine either way).
SMMIU_API_KEY=""

# Lets the site auto-notify Bing/Yandex (IndexNow protocol) the instant a tool or key page changes, and
# powers the "Resubmit to search engines" button in Admin -> Settings -> SEO. Any random string works -
# generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Changing it after launch requires re-verifying (the key is also served back at /<key>.txt).
INDEXNOW_KEY=""
