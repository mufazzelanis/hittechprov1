datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  DELIVERED
  REFUNDED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  phone     String?
  refCode   String?  @unique
  refClicks Int      @default(0)
  // "Forgot password" - a hashed, single-use, time-limited token (never the raw token: a DB read alone
  // must not be enough to take over an account). Works for both customers and admins, since both are
  // rows in this same table.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt DateTime @default(now())
  // ---- Admin team (only meaningful when role = ADMIN) ----
  adminRoleId  String?
  adminRole    AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)
  // false = suspended: can't sign in, and any open admin session stops working immediately.
  active       Boolean    @default(true)
  // Bumped on suspend / role change / password change / "sign out everywhere": every login token carries
  // the version it was issued with, and a token whose version no longer matches is rejected on the spot.
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
}

// A named set of admin permissions (see lib/permissions.js). System roles ship with the app; Owner is
// locked to full access. A role with members can't be deleted (members must be moved first), so nobody
// ever silently ends up without a role.
model AdminRole {
  id          String   @id @default(cuid())
  key         String?  @unique // system role key ("owner", "admin", ...); null for custom roles
  name        String
  description String?  @db.Text
  permissions String   @db.Text // JSON array of permission keys, or ["*"]
  color       String   @default("#E8352B")
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       User[]
}

// Who did what in the admin panel: sign-ins, team and role changes, settings, catalog edits, orders.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String // e.g. "auth.login", "team.role_change", "orders.update"
  target    String?
  detail    String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Category {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  sort   Int     @default(0)
  active Boolean @default(true)
  tools  Tool[]
}

model Tool {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @db.Text
  image       String?   @db.Text
  price       Int
  duration    String    @default("30 days")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accent      String    @default("#E8352B")
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  sort        Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Bundle {
  id        String   @id @default(cuid())
  name      String
  tagline   String
  price     Int
  icon      String   @default("zap")
  tools     String   @db.Text
  popular   Boolean  @default(false)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model PackPlan {
  id        String  @id @default(cuid())
  name      String
  tagline   String
  price     Int
  icon      String  @default("star")
  feature   String
  popular   Boolean @default(false)
  active    Boolean @default(true)
  sort      Int     @default(0)
}

model Review {
  id      String  @id @default(cuid())
  name    String
  text    String  @db.Text
  rating  Int     @default(5)
  source  String  @default("facebook")
  active  Boolean @default(true)
  sort    Int     @default(0)
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  active   Boolean @default(true)
  sort     Int     @default(0)
}

model Order {
  id        String      @id @default(cuid())
  number    Int         @unique @default(autoincrement())
  itemType  String      @default("tool")
  itemName  String
  amount    Int
  name      String
  email     String
  phone     String
  txnId     String?
  method    String?
  userId    String?
  refCode   String?
  commission Int     @default(0)
  note      String?     @db.Text
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  events    OrderEvent[]
  smmOrder  SmmOrder?
  // What was bought, line by line: [{ type, id, name, price, priceUsd, pkg?, files? }]. Product lines keep
  // a snapshot of their files so a buyer never loses a download if the product is later edited or removed.
  lines         Json?
  // Dollar amount for international (Payoneer) orders, fixed at the moment the order was placed.
  usdAmount     Float?
  // Payoneer payment-request URL the admin pastes in; the buyer gets it by email and in the Client Area.
  payLink       String?     @db.Text
  // Service orders: the buyer's requirements, sent from the Client Area after ordering.
  brief         String?     @db.Text
  // Last delivery message sent to the buyer (also shown in their Client Area), and delivered files.
  deliveryNote  String?     @db.Text
  deliveryFiles Json?
}

// Digital products sold for instant download: Canva templates, design files, landing page kits...
model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  kind         String   @default("Canva Template")
  tagline      String?
  description  String   @db.Text
  image        String?  @db.Text
  gallery      String?  @db.Text // extra preview image URLs, one per line
  price        Int // ৳, for bKash/Nagad/Rocket buyers
  priceUsd     Float    @default(0) // $, for international buyers; 0 = convert from ৳ at the site's dollar rate
  previewUrl   String?  @db.Text // live demo / Canva preview link
  includes     String?  @db.Text // "What's included", one per line
  deliveryText String?  @db.Text // shown only to paying buyers, e.g. the Canva template link
  files        String?  @db.Text // JSON: [{ id, name, stored, size }] - private files, never public URLs
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
}

// Done-for-you services (design, landing pages, digital marketing) sold in Basic/Standard/Premium packages.
model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  kind        String   @default("Graphic Design")
  tagline     String?
  description String   @db.Text
  image       String?  @db.Text
  gallery     String?  @db.Text // portfolio image URLs, one per line
  packages    String   @db.Text // JSON: [{ name, price, priceUsd, days, revisions, features: [] }]
  questions   String?  @db.Text // what the buyer is asked after ordering, one question per line
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
}

// Audit trail for one order: every status change (logged automatically) plus admin notes and
// "delivery details sent" entries (logged explicitly) - shown as a timeline in the order detail drawer.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // "status" | "note" | "delivery"
  message   String   @db.Text
  byName    String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Setting {
  key   String @id
  value String @db.Text
}

// Auto-translate cache: every English string translated once (client-side "EN/BN" toggle) is stored here
// keyed by a hash of the source text, so the same sentence is never sent to the translation service
// twice - the very first visitor to see a given piece of text in Bangla "warms" it for everyone after.
model Translation {
  id        String   @id @default(cuid())
  hash      String
  lang      String
  source    String   @db.Text
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@unique([hash, lang])
}

model Lead {
  id        String   @id @default(cuid())
  type      String   @default("contact")
  name      String
  email     String
  phone     String?
  message   String?  @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Prompt {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  category   String?
  image      String?  @db.Text
  accent     String   @default("#E8352B")
  promptText String   @db.Text
  tags       String?
  featured   Boolean  @default(false)
  active     Boolean  @default(true)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
}

model Visit {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String?
  name        String?
  email       String?
  phone       String?
  path        String
  referrer    String?  @db.Text
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ip          String?
  country     String?
  region      String?
  city        String?
  device      String?
  browser     String?
  os          String?
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // order | lead | claim | payout
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// SMM (social media marketing) reseller catalog, mirrored from the provider's `services` API and
// cached here so the public page never calls the provider directly. `providerServiceId`/`providerRate`
// are provider-sourced and refreshed on every admin sync; `sellRate`/`category`/`active`/`sort` are the
// admin's own pricing/merchandising choices and a sync never overwrites them.
model SmmService {
  id                String     @id @default(cuid())
  providerServiceId Int        @unique
  name              String
  category          String     @default("Other")
  type              String     @default("Default")
  providerRate      Float // provider's price per 1000, in their currency (USD)
  sellRate          Int // your price per 1000, in ৳ - admin editable
  min               Int
  max               Int
  refill            Boolean    @default(false)
  cancel            Boolean    @default(false)
  active            Boolean    @default(false)
  sort              Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  orders            SmmOrder[]

  @@index([category, active, sort])
}

// One row per SMM order, 1:1 with the Order it was checked out as (Order carries the shared
// name/email/phone/payment/status fields already used by every other order type on the site).
// `providerOrderId` stays null until an admin explicitly sends it to the provider - payment here is
// verified manually (same as every other order), so placing the real provider order is a deliberate,
// admin-triggered action, never automatic on checkout.
model SmmOrder {
  id              String     @id @default(cuid())
  orderId         String     @unique
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId       String
  service         SmmService @relation(fields: [serviceId], references: [id])
  link            String     @db.Text
  quantity        Int
  providerOrderId Int?
  providerStatus  String     @default("Not sent")
  startCount      Int?
  remains         Int?
  charge          Float?
  lastSyncedAt    DateTime?
  createdAt       DateTime   @default(now())

  @@index([providerStatus])
}

model Payout {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userEmail String
  amount    Int
  method    String
  account   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

// A customer's wallet deposit request (they paid the site's own bKash/Nagad/etc. and are claiming it
// here, exactly like an order's payment - same manual admin verification). There is no stored balance
// field anywhere: a user's spendable balance is always computed on demand as
// sum(APPROVED topups) - sum(orders paid with method "Wallet", excluding cancelled/refunded) - see
// lib/wallet.js. That mirrors how affiliate balance already works in this codebase (lib/affiliate.js) -
// deriving the number from source records means it can never drift out of sync with reality, and a
// refunded wallet order automatically gives the money back with no extra code.
model WalletTopup {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userEmail String
  amount    Int
  method    String
  txnId     String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())

  @@index([userId, status])
}
